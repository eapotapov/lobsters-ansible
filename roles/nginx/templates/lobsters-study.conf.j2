{% for version in versions %}
server {
    listen 80;
    server_name {{ version.hostname }};

    access_log /var/log/nginx/{{ version.name }}.access.log;
    error_log /var/log/nginx/{{ version.name }}.error.log;

    location = /robots.txt {
        default_type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    location / {
        proxy_pass http://127.0.0.1:{{ version.port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

{% endfor %}
